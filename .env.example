PORT=4000

# --- Base de données ---
# sqlite : développement local, aucun serveur à installer (vecteurs via sqlite-vec)
# pg     : production, PostgreSQL + pgvector (Supabase / Neon : CREATE EXTENSION vector fonctionne)
DB_DRIVER=sqlite
SQLITE_PATH=./data/rag.db
# Requis seulement si DB_DRIVER=pg
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Génération : Groq (compatible OpenAI) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
# Vérifie l'identifiant dans ta console Groq ; llama-3.1-8b-instant = plus rapide, moins précis
LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings : Groq n'en propose pas, on utilise Gemini (palier gratuit) ---
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBED_API_KEY=AIza...
# text-embedding-004 n'existe plus ; gemini-embedding-001 produit 3072 dimensions par défaut
EMBED_MODEL=gemini-embedding-001
# Dimension des vecteurs stockés (max 2000). Avec gemini-embedding-001, on demande 768
EMBEDDING_DIM=768
EMBED_SEND_DIMENSIONS=true

# --- Protection du quota d'embeddings ---
# Plafond de tokens envoyés par minute (palier gratuit Gemini : 30000, on garde une marge). 0 = illimité
EMBED_TPM=25000
EMBED_BATCH_SIZE=16
# Refuse un document qui produirait plus de morceaux que ça
MAX_CHUNKS_PER_DOC=400

# --- OCR (PDF scannés et images) — Tesseract ---
OCR_LANGS=fra+eng
OCR_MAX_PAGES=30
